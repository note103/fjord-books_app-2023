<h1><%= @user.username %></h1>
<p><%= User.human_attribute_name('full_name') %>: <%= @user.full_name %></p>
<p><%= User.human_attribute_name('email') %>: <%= @user.email %></p>
<p><%= User.human_attribute_name('postal_code') %>: <%= @user.postal_code %></p>
<p><%= User.human_attribute_name('address') %>: <%= @user.address %></p>
<p><%= User.human_attribute_name('bio') %>: <%= @user.bio %></p>
<nav class="page-nav">
  <%= link_to t('views.common.back', name: i18n_pluralize(User.model_name.human.downcase)), users_path %>
  <% if current_user == @user %>
    | <%= link_to t('views.common.edit', name: User.model_name.human), edit_user_registration_path %>
    <%= button_to t('devise.registrations.edit.cancel_my_account'), registration_path(@user), data: { turbo_confirm: t('devise.registrations.edit.are_you_sure') }, method: :delete %>
  <% end %>
</nav>
