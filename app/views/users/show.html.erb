<h1><%= @user.email %></h1>
<p>ID: <%= @user.id %></p>
<p><%= t('activerecord.attributes.user.postal_code') %>: <%= @user.postal_code %></p>
<p><%= t('activerecord.attributes.user.address') %>: <%= @user.address %></p>
<p><%= t('activerecord.attributes.user.bio') %>: <%= @user.bio %></p>
<p><%= t('activerecord.attributes.user.created_at') %>: <%= @user.created_at %></p>
<p><%= t('activerecord.attributes.user.updated_at') %>: <%= @user.updated_at %></p>
<% if current_user == @user %>
  <%= link_to t('views.common.edit', name: User.model_name.human), edit_user_registration_path %>
<% end %>
