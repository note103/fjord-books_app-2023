<p style="color: green"><%= notice %></p>

<h1><%= t('helpers.titles.index', model: Book.model_name.human) %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t('helpers.links.show', model: Book.model_name.human), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t('helpers.links.new', model: Book.model_name.human), new_book_path %>
</nav>

<div id="locale-switcher" class="page-nav">
  <% other_locale = I18n.locale == :ja ? :en : :ja %>
  <%= link_to t('helpers.utility.switch_language'), url_for(locale: other_locale) %>
</div>
